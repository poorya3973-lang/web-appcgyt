{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appcgyt",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "65f08b08-29ab-4c99-aece-60a34adbb718","database_name": "web-appdser" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f1f11fe4a9b74f94bd5a48c3c83d7bb1" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
